    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2"
  }
