# Use the internal MySQL hostname from Coolify and enter credentials as issued.
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=3306
DB_USER=
# Set true to enable MySQL TLS with certificate verification.
DB_SSL=false
# Optional PEM CA certificate for MySQL servers using a private CA.
DB_SSL_CA=

APP_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
PORT=3000
UPLOAD_DIR=./data/uploads
DEFAULT_COUNTRY=LK

# Simulation processes the queue without sending WhatsApp messages.
DELIVERY_MODE=simulate
SEND_PER_MINUTE=8
WASSENGER_API_TOKEN=
WASSENGER_DEVICE_ID=
WASSENGER_CONNECTOR=
WASSENGER_WEBHOOK_SECRET=
WASSENGER_TEMPLATE_NAME=
WASSENGER_TEMPLATE_LANGUAGE=
# For Business API, use the approved wording with one {{ticket_number}} variable.
WASSENGER_TEMPLATE_BODY=
