<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Queue · WaBulk</title>
  <link rel="stylesheet" href="/assets/app.css">
  <script src="/assets/status-refresh.js" defer></script>
  <script src="/assets/queue.js" defer></script>
</head>
<body>
  <%- include('navigation', { active: archive ? 'events' : 'queue' }) %>

  <main class="workspace" data-status-refresh="<%= refreshUrl %>" data-event-id="<%= eventId ?? '' %>">
    <div class="page-title">
      <h1><%= archive ? `${archive.name} · Delivery history` : eventName ? `${eventName} · Sending queue` : 'Sending queue' %></h1>
      <% if (archive) { %>
        <div class="row-actions"><a class="button" href="/events">Past events</a><a class="button" href="/events/<%= archive.id %>/files">Tickets</a></div>
      <% } else { %>
      <div class="row-actions">
      <% if (eventsEnabled) { %><a class="button" href="/events">Switch event</a><% } %>
      <div data-status-region="queue-controls">
      <% if (dashboard?.state === 'running' || dashboard?.state === 'paused') { %>
        <div class="row-actions">
          <form action="/queue/control" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
            <button type="submit" name="action" value="<%= dashboard.state === 'running' ? 'pause' : 'resume' %>" class="button"><%= dashboard.state === 'running' ? 'Pause sending' : 'Resume sending' %></button>
          </form>
          <% if (dashboard.state === 'paused' && mode === 'live') { %>
            <form action="/queue/wassenger" method="post">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
              <button type="submit" class="button button-primary">Continue from last sent</button>
            </form>
          <% } %>
        </div>
      <% } else if (dashboard?.state === 'settings-changed') { %>
        <form action="/queue/control" method="post">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
          <button type="submit" name="action" value="end-changed" class="button">End previous batch</button>
        </form>
      <% } else if (canStart) { %>
        <button type="button" class="button button-primary" aria-haspopup="dialog" aria-controls="confirm-start" data-confirm-start>Start sending</button>
      <% } else if (dashboard?.state === 'scheduled') { %>
        <button type="button" class="button" disabled>Batch scheduled</button>
      <% } else { %><button type="button" class="button" disabled>Start sending</button><% } %>
      </div>
      </div>
      <% } %>
    </div>
    <% if (dashboard) { %>
      <dialog class="confirm-dialog" id="confirm-start" aria-labelledby="confirm-start-title" aria-describedby="confirm-start-description">
        <h2 id="confirm-start-title"><%= mode === 'live' ? 'Start sending invitations?' : 'Start simulated batch?' %></h2>
        <p id="confirm-start-description"><%= mode === 'live'
          ? 'Start sending WhatsApp invitations to the queued recipients. By continuing, you confirm they agreed to receive these messages.'
          : 'Run the queued invitations in simulation mode. No WhatsApp messages will be sent.' %> If another event is ahead, this batch will start automatically when it reaches the front of the send queue.</p>
        <form action="/queue/control" method="post">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
          <% if (mode === 'live') { %><input type="hidden" name="consent" value="yes"><% } %>
          <div class="row-actions confirm-actions">
            <button type="submit" formmethod="dialog" class="button" autofocus>Cancel</button>
            <button type="submit" name="action" value="start" class="button button-primary"><%= mode === 'live' ? 'Start sending' : 'Start simulation' %></button>
          </div>
        </form>
      </dialog>
    <% } %>
    <% if (error) { %><p class="notice notice-error" role="alert"><%= error %></p><% } %>
    <% if (notice) { %><p class="notice notice-success" role="status"><%= notice %></p><% } %>
    <section class="panel queue-dashboard" aria-label="Queue summary" data-status-region="queue-summary">
      <div class="queue-summary">
        <div>
          <h2><%= archive ? 'Archived event' : dashboard?.state === 'running' ? 'Sending' : dashboard?.state === 'paused' ? 'Paused' : dashboard?.state === 'scheduled' ? 'Scheduled to send' : dashboard?.state === 'settings-changed' ? 'Sending settings changed' : 'Waiting to start' %></h2>
          <% if (dashboard?.state === 'scheduled') { %><p class="muted">This batch starts automatically when earlier batches finish.</p><% } %>
          <% if (!archive && mode === 'simulate') { %><p class="muted">Simulation mode · Up to <%= rate %> submissions per minute</p><% } %>
          <% if (!archive && mode === 'live') { %><p class="muted">Live mode · Up to <%= rate %> submissions per minute</p><% } %>
          <% if (dashboard?.state === 'settings-changed') { %><p class="muted">Restore the previous settings to continue, or end that batch to review its unsent work.</p><% } %>
          <% if (dashboard && !dashboard.liveReady) { %><p class="muted">Complete a delivered <a href="/test-sends">live test</a> to unlock event sending.</p><% } %>
        </div>
        <div class="row-actions">
          <a class="button" href="<%= refreshUrl %>">Refresh status</a>
          <% if (!archive && mode === 'live') { %>
            <form action="/queue/wassenger" method="post">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
              <button type="submit" class="button">Check Wassenger queue</button>
            </form>
          <% } %>
        </div>
      </div>
      <% const activeJobs = dashboard?.runId ? dashboard.jobs.filter(job => job.runId === dashboard.runId) : []; %>
      <% if (activeJobs.length) { const attempted = activeJobs.filter(job => job.status !== 'queued').length; %>
        <p class="muted"><%= attempted %> of <%= activeJobs.length %> attempted in this batch</p>
        <progress class="batch-progress" value="<%= attempted %>" max="<%= activeJobs.length %>" aria-label="Batch progress"></progress>
      <% } %>
      <div class="queue-status-summary">
        <h3>App status</h3>
        <dl class="queue-counts">
          <% const summary = mode === 'live' ? ['queued', 'submitting', 'submitted', 'failed', 'review'] : ['queued', 'submitted', 'delivered', 'failed', 'review']; %>
          <% for (const status of (archive ? [...summary.slice(1), 'cancelled', ...(appCounts.unsent ? ['unsent'] : [])] : summary)) { %>
            <div><dt><%= deliveryLabels[status] %></dt><dd class="count-<%= status %>"><%= appCounts[status] %></dd></div>
          <% } %>
        </dl>
      </div>
      <% if (mode === 'live') { %>
        <div class="queue-status-summary">
          <h3>Wassenger status</h3>
          <% if (!archive) { %><p class="muted">Recorded invitation statuses. Check the Wassenger queue for the sender’s live count.</p><% } %>
          <dl class="queue-counts">
            <% for (const status of Object.keys(providerCounts)) { %>
              <div><dt><%= wassengerLabels[status] %></dt><dd class="count-<%= status %>"><%= providerCounts[status] %></dd></div>
            <% } %>
          </dl>
        </div>
      <% } %>
    </section>

    <section class="panel queue-invitations" aria-labelledby="queue-invitations-title">
      <div class="table-toolbar">
        <h2 id="queue-invitations-title">Invitations</h2>
        <form class="queue-search" method="get" action="<%= queuePath %>">
          <% if (archive && mode) { %>
            <label><span class="visually-hidden">Delivery mode</span><select name="mode" class="button button-small">
              <option value="live" <%= mode === 'live' ? 'selected' : '' %>>Live</option>
              <option value="simulate" <%= mode === 'simulate' ? 'selected' : '' %>>Simulation</option>
            </select></label>
          <% } %>
          <label><span class="visually-hidden">Filter by outcome</span><select name="view" class="button button-small" data-status-filters>
            <option value="all" <%= view === 'all' ? 'selected' : '' %>>All statuses</option>
            <% for (const status of statuses) { %>
              <option value="<%= status %>" <%= view === status ? 'selected' : '' %>><%= deliveryLabels[status] %> (<%= counts[status] %>)</option>
            <% } %>
          </select></label>
          <label class="search-control"><span class="visually-hidden">Search queue</span><input type="search" name="q" value="<%= search %>" placeholder="Search name, phone or ticket"></label>
          <button type="submit" class="button button-small">Search</button>
        </form>
      </div>

      <div data-status-region="queue-results">
      <% if (!rows.length) { %>
        <p class="empty-state table-empty"><%= archive ? 'No invitations in this view.' : search ? 'No invitations match that search.' : view === 'removed' ? 'Removed invitations will appear here.' : 'Select recipients to add invitations to the queue.' %></p>
      <% } else { %>
        <div class="table-wrap" role="region" aria-label="Invitations" tabindex="0">
          <div class="delivery-list">
            <%- include('delivery-columns') %>
            <% for (const row of rows) { %>
              <details class="delivery-entry" data-status-detail="<%= row.id %>" id="invitation-<%= row.id %>">
                <%- include('delivery-summary', { item:row, appStatus:row.appStatus, provider:row.provider, deliveryMode:row.job?.mode ?? mode, note:row.job?.note }) %>
                <%- include('delivery-details', { provider:row.provider, phone:row.phone, note:row.job?.note, reference:row.job?.reference }) %>
                <div class="invitation-preview queue-invitation-preview">
                  <a href="/files/images/<%= row.imageId %>" target="_blank" rel="noopener" aria-label="Open saved ticket <%= row.ticketNumber %> image">
                    <img loading="lazy" src="/files/images/<%= row.imageId %>" alt="Ticket <%= row.ticketNumber %>">
                  </a>
                  <div>
                    <strong>Saved invitation</strong><p class="invitation-message"><%= row.message %></p>
                    <% if (!archive && row.status === 'queued' && !row.job?.reference && !row.job?.recoveryReference) { %>
                      <form method="post" action="/queue/<%= row.id %>/remove">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <button class="button button-small" type="submit" aria-label="Remove ticket <%= row.ticketNumber %> from the queue">Remove</button>
                      </form>
                    <% } %>
                    <% if (!archive && row.status === 'failed' && row.job?.retryable) { %>
                      <form method="post" action="/queue/retry">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <input type="hidden" name="job" value="<%= row.job.id %>">
                        <button class="button button-small" type="submit" aria-label="Retry ticket <%= row.ticketNumber %>">Retry</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </details>
            <% } %>
          </div>
        </div>
        <% if (pages > 1) { %>
          <nav class="pagination" aria-label="Queue pages">
            <span><%= (page - 1) * 25 + 1 %>–<%= Math.min(page * 25, total) %> of <%= total %></span>
            <div class="row-actions">
              <% if (page > 1) { %><a class="button button-small" href="<%= queueUrl(page - 1) %>">Previous</a><% } %>
              <% if (page < pages) { %><a class="button button-small" href="<%= queueUrl(page + 1) %>">Next</a><% } %>
            </div>
          </nav>
        <% } %>
      <% } %>
      </div>
    </section>
  </main>
</body>
</html>
