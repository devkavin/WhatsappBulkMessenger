<section class="panel test-history" aria-labelledby="test-history-label" data-status-region="test-history">
  <h2 id="test-history-label">Test history</h2>
  <% if (!history.length) { %><p class="empty-state">Test results will appear here.</p><% } else { %>
    <div class="table-wrap" role="region" aria-label="Test delivery results" tabindex="0">
      <div class="delivery-list">
        <%- include('delivery-columns') %>
        <% for (const item of history) { %>
          <% const { appStatus, provider } = deliveryDisplay(item); %>
          <details class="delivery-entry" data-status-detail="<%= item.id %>">
            <%- include('delivery-summary', { item, appStatus, provider, deliveryMode:item.mode, note:item.note }) %>
            <%- include('delivery-details', { provider, phone:item.phone, note:item.note, reference:item.status === 'review' ? item.reference : null }) %>
          </details>
        <% } %>
      </div>
    </div>
  <% } %>
</section>
