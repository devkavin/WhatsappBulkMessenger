<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Test sends · Dinner Dance</title>
  <link rel="stylesheet" href="/assets/app.css">
  <script src="/assets/test-sends.js" defer></script>
</head>
<body>
  <%- include('navigation', {active:'test-sends'}) %>
  <main class="workspace">
    <div class="page-title">
      <div><h1>Test sends</h1><p class="muted"><%= mode === 'simulate' ? 'Simulation mode' : 'Live Wassenger sender' %></p></div>
      <a class="button" href="/test-sends">Refresh status</a>
    </div>
    <% if (error) { %><p class="notice notice-error" role="alert"><%= error %></p><% } %>
    <% if (queued) { %><p class="notice notice-success" role="status">Test invitations queued.</p><% } %>
    <div class="test-layout">
      <section class="panel" aria-labelledby="saved-test-recipients">
        <h2 id="saved-test-recipients">Test recipients</h2>
        <form class="test-form" action="/test-sends/recipients" method="post">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Name <input name="name" maxlength="200" required></label>
          <label>WhatsApp number <input name="phone" type="tel" required></label>
          <label class="control-check"><input type="checkbox" name="consent" value="yes" required> The recipient agreed to receive test messages</label>
          <button type="submit" class="button">Add recipient</button>
        </form>
        <% if (recipients.length) { %>
          <ul class="test-recipient-list">
            <% for (const person of recipients) { %>
              <li>
                <label><input type="checkbox" name="recipient" value="<%= person.id %>" form="send-test"> <strong><%= person.name %></strong> <span class="muted"><%= person.phone %></span></label>
                <form action="/test-sends/recipients/<%= person.id %>/remove" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button type="submit" class="button button-small" aria-label="Remove <%= person.name %> from test recipients">Remove</button>
                </form>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>
      <section class="panel" aria-labelledby="test-preview-label">
        <h2 id="test-preview-label">Preview and send</h2>
        <form class="test-form" id="send-test" method="post" action="/test-sends/send" enctype="multipart/form-data" data-template="<%= template %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="testKey" value="<%= key %>">
          <input type="hidden" name="version" value="<%= version %>">
          <label>Sample ticket number <input name="ticket" maxlength="64" value="TEST-001" required></label>
          <label>Sample ticket image <input type="file" name="image" accept=".png,.jpg,.jpeg,image/png,image/jpeg" required></label>
          <div class="invitation-preview test-preview">
            <img data-sample-image alt="Sample ticket image" hidden>
            <div><strong>Message preview</strong><p class="invitation-message" data-sample-message><%= template.replace(/\{\{\s*ticket_number\s*\}\}/g, 'TEST-001') %></p></div>
          </div>
          <button type="submit" class="button button-primary" <%= recipients.length ? '' : 'disabled' %>>Send test</button>
        </form>
      </section>
    </div>
    <section class="panel test-history" aria-labelledby="test-history-label">
      <h2 id="test-history-label">Test history</h2>
      <% if (!history.length) { %><p class="empty-state">Test results will appear here.</p><% } else { %>
        <div class="table-wrap" role="region" aria-label="Test delivery results" tabindex="0">
          <table><thead><tr><th scope="col">Recipient</th><th scope="col">Ticket no.</th><th scope="col">Mode</th><th scope="col">App status</th><th scope="col">Wassenger status</th><th scope="col">Last update</th></tr></thead>
          <tbody><% for (const item of history) { %>
            <% const { appStatus, provider } = deliveryDisplay(item); %>
            <tr>
              <th scope="row"><%= item.name %><div class="muted"><%= item.phone %></div></th>
              <td><%= item.ticketNumber %></td><td><%= item.mode === 'simulate' ? 'Simulation' : 'Live' %></td>
              <td><span class="status delivery-<%= appStatus %>"><%= deliveryLabels[appStatus] %></span>
                <% if (item.note) { %><p class="row-hint"><%= item.note %></p><% } %>
                <% if (item.reference && item.status === 'review') { %><p class="muted"><code><%= item.reference %></code></p><% } %>
              </td><td><%- include('wassenger-status', { provider }) %></td>
              <td><time datetime="<%= item.updatedAt.toISOString() %>"><%= displayTime.format(item.updatedAt) %></time></td>
            </tr>
          <% } %></tbody></table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
