<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Files · Dinner Dance</title>
  <link rel="stylesheet" href="/assets/app.css">
  <script src="/assets/uploads.js" defer></script>
</head>
<body>
  <%- include('navigation', { active: archive ? 'events' : 'files' }) %>

  <main class="workspace">
    <div class="page-title">
      <h1><%= archive ? `${archive.name} · Tickets` : 'Manage uploads' %></h1>
      <% if (archive) { %>
        <div class="row-actions"><a class="button" href="/events">Past events</a><a class="button" href="/events/<%= archive.id %>/queue">Delivery history</a></div>
      <% } else { %><a class="button" href="/recipients">Back to recipients</a><% } %>
    </div>

    <% if (error) { %><p class="notice notice-error" role="alert"><%= error %></p><% } %>
    <% if (notice) { %><p class="notice notice-success" role="status"><%= notice %></p><% } %>

    <section class="panel" aria-labelledby="contact-csv">
      <h2 id="contact-csv">Contact CSV</h2>
      <div class="file-row">
        <div class="file-summary">
          <span class="file-mark" aria-hidden="true"></span>
          <div>
            <strong class="file-name"><%= csv?.filename ?? 'No CSV uploaded' %></strong>
            <p class="muted"><%= csv ? `${csv.contacts.length} ${csv.contacts.length === 1 ? 'row' : 'rows'} imported` : archive ? '' : 'Include Ticket No, Name and Contact.' %></p>
          </div>
        </div>
        <% if (csv) { %>
          <% if (issues.length) { %>
            <span class="status status-warning"><span aria-hidden="true">⚠</span> <%= issues.length %> rows need attention</span>
          <% } else { %>
            <span class="status status-success"><span aria-hidden="true">✓</span> Ready</span>
          <% } %>
        <% } %>
        <% if (!archive) { %><form action="/files/csv" method="post" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
          <label class="button file-trigger">
            <input class="visually-hidden" data-auto-submit type="file" name="csv" accept=".csv,text/csv" required>
            <%= csv ? 'Replace CSV' : 'Choose CSV' %>
          </label>
          <noscript><button class="button" type="submit">Upload CSV</button></noscript>
        </form><% } %>
      </div>
      <% if (issues.length) { %>
        <details class="csv-issues">
          <summary>View CSV issues</summary>
          <ul>
            <% for (const contact of issues) { %>
              <li>Row <%= contact.row %><% if (contact.ticketNumber) { %> · Ticket <%= contact.ticketNumber %><% } %> · <%= contact.issues.join(', ') %></li>
            <% } %>
          </ul>
        </details>
      <% } %>
    </section>

    <section class="panel" id="images" aria-labelledby="ticket-images">
      <h2 id="ticket-images">Ticket images</h2>
      <p class="muted section-caption"><%= matchedCount %> of <%= allCount %> tickets matched</p>

      <% if (!archive) { %>
      <form class="upload-zone" data-bulk-upload data-batch-size="<%= batchSize %>" data-max-file-size="<%= maxImageBytes %>" action="/files/images" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
        <div class="file-summary">
          <span class="upload-mark" aria-hidden="true">↑</span>
          <div>
            <strong>Drop ticket images here</strong>
            <p class="muted">Use the ticket number as the filename, such as <code>0042.png</code>.</p>
            <p class="muted image-limit">PNG or JPEG, up to 5 MB per image.</p>
          </div>
        </div>
        <label class="button button-primary file-trigger">
          <input class="visually-hidden" type="file" name="images" accept=".png,.jpg,.jpeg,image/png,image/jpeg" multiple required>
          Choose images
        </label>
        <noscript><button class="button" type="submit">Upload images</button></noscript>
      </form>
      <div data-upload-feedback class="upload-feedback" hidden>
        <p data-upload-status role="status"></p>
        <progress data-upload-progress max="100" value="0" aria-label="Image upload progress"></progress>
        <ul data-upload-errors></ul>
        <button type="button" class="button button-small" data-refresh hidden>Refresh matches</button>
      </div>
      <% } %>

      <nav class="filter-nav" aria-label="Image views">
        <a href="<%= filesPath %>?view=all#images" <%= view === 'all' ? 'aria-current=page' : '' %>>All tickets <span><%= allCount %></span></a>
        <a href="<%= filesPath %>?view=attention#images" <%= view === 'attention' ? 'aria-current=page' : '' %>>Needs attention <span><%= attentionCount %></span></a>
        <a href="<%= filesPath %>?view=unmatched#images" <%= view === 'unmatched' ? 'aria-current=page' : '' %>>Unmatched uploads <span><%= unmatchedCount %></span></a>
      </nav>

      <% if (!total) { %>
        <p class="empty-state"><%= archive ? 'No tickets in this view.' : view === 'unmatched' ? 'Every uploaded image has a matching ticket number.' : !csv ? 'Upload a CSV to see which tickets need an image.' : 'All tickets have a matching image.' %></p>
      <% } else { %>
        <div class="table-wrap" role="region" aria-label="Ticket image matches" tabindex="0">
          <table>
            <thead><tr>
              <th scope="col"><%= view === 'unmatched' ? 'Filename' : 'Ticket no.' %></th>
              <% if (view !== 'unmatched') { %><th scope="col">Name</th><% } %>
              <th scope="col">Image status</th><th scope="col">Actions</th>
            </tr></thead>
            <tbody>
              <% if (view === 'unmatched') { %>
                <% for (const image of unmatched) { %>
                  <tr>
                    <th scope="row"><%= image.filename %></th>
                    <td><span class="status status-warning"><span aria-hidden="true">⚠</span> Unmatched</span></td>
                    <td><div class="row-actions">
                      <a href="/files/images/<%= image.id %>" target="_blank" rel="noopener">View image</a>
                      <% if (!archive) { %><form action="/files/images/<%= image.id %>/remove" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <button type="submit" class="button button-small" aria-label="Remove <%= image.filename %> from draft">Remove</button>
                      </form><% } %>
                    </div></td>
                  </tr>
                <% } %>
              <% } else { %>
                <% for (const row of rows) { %>
                  <tr>
                    <th scope="row"><%= row.contact.ticketNumber || '—' %></th>
                    <td><%= row.contact.name || '—' %></td>
                    <td>
                      <% if (row.status === 'matched') { %><span class="status status-success"><span aria-hidden="true">✓</span> Matched</span>
                      <% } else { %><span class="status status-warning"><span aria-hidden="true">⚠</span> <%= row.status === 'conflict' ? 'Conflicting images' : 'Missing image' %></span><% } %>
                    </td>
                    <td>
                      <% if (row.status === 'matched') { %>
                        <a href="/files/images/<%= row.images[0].id %>" target="_blank" rel="noopener">View image</a>
                      <% } else if (row.status === 'conflict') { %>
                        <details class="conflict-actions">
                          <summary>Review images</summary>
                          <% for (const image of row.images) { %>
                            <div class="row-actions">
                              <a href="/files/images/<%= image.id %>" target="_blank" rel="noopener"><%= image.filename %></a>
                              <% if (!archive) { %><form action="/files/images/<%= image.id %>/remove" method="post">
                                <input type="hidden" name="_csrf" value="<%= csrf %>">
                                <button type="submit" class="button button-small" aria-label="Remove <%= image.filename %> from draft">Remove</button>
                              </form><% } %>
                            </div>
                          <% } %>
                        </details>
                      <% } else if (!archive && row.contact.ticketNumber) { %>
                        <form action="/files/images" method="post" enctype="multipart/form-data">
                          <input type="hidden" name="_csrf" value="<%= csrf %>">
                          <% if (eventId) { %><input type="hidden" name="eventId" value="<%= eventId %>"><% } %>
                          <input type="hidden" name="ticket" value="<%= row.contact.ticketNumber %>">
                          <label class="button button-small file-trigger">
                            <input class="visually-hidden" data-auto-submit type="file" name="images" accept=".png,.jpg,.jpeg,image/png,image/jpeg" aria-label="Add image for ticket <%= row.contact.ticketNumber %>" required>
                            Add image
                          </label>
                          <noscript><button class="button button-small" type="submit">Upload</button></noscript>
                        </form>
                      <% } else if (!archive) { %>
                        <a href="#contact-csv">Review CSV</a>
                      <% } %>
                    </td>
                  </tr>
                <% } %>
              <% } %>
            </tbody>
          </table>
        </div>
        <% if (pages > 1) { %>
          <nav class="pagination" aria-label="Results pagination">
            <span><%= offset + 1 %>–<%= end %> of <%= total %></span>
            <div class="row-actions">
              <% if (page > 1) { %><a class="button button-small" href="<%= filesPath %>?view=<%= view %>&amp;page=<%= page - 1 %>#images">Previous</a><% } %>
              <% if (page < pages) { %><a class="button button-small" href="<%= filesPath %>?view=<%= view %>&amp;page=<%= page + 1 %>#images">Next</a><% } %>
            </div>
          </nav>
        <% } %>
      <% } %>
    </section>
  </main>
</body>
</html>
